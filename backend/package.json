{
  "name": "pumpfun-backend",
  "version": "1.0.0",
  "description": "Backend service for PumpFun token creation and initial purchases",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "postinstall": "npm run build"
  },
  "dependencies": {
    "@solana/web3.js": "^1.87.6",
    "bs58": "^5.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "node-fetch": "^2.6.7",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/node": "^20.10.5",
    "@types/node-fetch": "^2.6.4",
    "@types/testing-library__jest-dom": "^5.14.9",
    "ts-node-dev": "^2.0.0"
  }
}
